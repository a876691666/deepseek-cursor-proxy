# ---- Runtime stage (skips Go build, uses pre-built binary) ----
FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S app && adduser -S -G app app && \
    mkdir -p /home/app/.deepseek-cursor-proxy/pb_data && \
    mkdir -p /home/app/.deepseek-cursor-proxy && \
    chown -R app:app /home/app

# Copy pre-built linux/amd64 binary from local build folder
COPY build/deepseek-cursor-proxy-linux-amd64 /usr/local/bin/deepseek-cursor-proxy

USER app
WORKDIR /home/app

EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:9000/healthz >/dev/null 2>&1 || exit 1

CMD ["/usr/local/bin/deepseek-cursor-proxy", "serve"]
